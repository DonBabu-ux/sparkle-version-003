<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
        android:theme="@style/AppTheme.NoActionBarLaunch"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">

        <!-- FCM: fallback channel (messages set android.notification.channel_id
             explicitly; this covers any payload without one) + status bar icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="system" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Accent color: circle behind the status-bar icon + accent on Android 5-7 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sparkle_notification_color" />


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: Canonical HTTPS referral invitations -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sparkleapp.com" android:pathPrefix="/invite" />
                <data android:scheme="https" android:host="sparklewebapp.vercel.app" android:pathPrefix="/invite" />
            </intent-filter>

            <!-- Custom Scheme deep link fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sparkle" android:host="invite" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime notification permission (requested by the
         push/local notifications Capacitor plugins) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Channel vibration (notification channels set vibration=true) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice calls & voice notes (WebView getUserMedia needs the app to hold these) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video calls (@capacitor/camera also declares this; kept explicit for WebView getUserMedia) -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
