<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
        android:theme="@style/AppTheme.NoActionBarLaunch"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustNothing"
        android:exported="true"
        android:enableOnBackInvokedCallback="true">

        <!-- FCM: fallback channel (messages set android.notification.channel_id
             explicitly; this covers any payload without one) + status bar icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="system" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Accent color: circle behind the status-bar icon + accent on Android 5-7 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sparkle_notification_color" />


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: Canonical HTTPS referral invitations -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sparkleapp.com" android:pathPrefix="/invite" />
                <data android:scheme="https" android:host="sparklewebapp.vercel.app" android:pathPrefix="/invite" />
            </intent-filter>

            <!-- Custom Scheme deep link fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sparkle" android:host="invite" />
                <!-- Handed over by IncomingCallActivity / CallService on answer
                     so the SPA opens its call screen via @capacitor/app's
                     appUrlOpen; see CallCoordinator.launchAppForCall() -->
                <data android:scheme="sparkle" android:host="call" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Telecom self-managed call integration. Bound only by the platform
          (BIND_TELECOM_CONNECTION_SERVICE is signature-gated); the plugin
          registers a self-managed PhoneAccount pointing here. API 26+ only —
          see SparkleCallConnectionService for the pre-O fallback path.
        -->
        <service
            android:name=".plugins.SparkleCallConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!--
          Keeps an ongoing call alive while the app is backgrounded; covers the
          FOREGROUND_SERVICE / FOREGROUND_SERVICE_MICROPHONE / CAMERA
          declarations. stopWithTask=false so swiping the app away does not
          drop the caller mid-sentence.
        -->
        <!--
          Call alerts arriving while the app process is dead. Declared in the
          app manifest (which outranks the Capacitor push plugin's library
          manifest entry) so every FCM message reaches this service first;
          non-call messages are forwarded back into the push plugin by
          SparkleFirebaseMessagingService.onMessageReceived(). Backend must
          send data payloads with {"type": "call", ...} at high priority.
        -->
        <service
            android:name=".plugins.SparkleFirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".plugins.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera"
            android:stopWithTask="false" />

        <!-- Lock-screen incoming-call UI, launched by the ring notification's
             full-screen intent. Own task + no history + excluded from recents
             so answering a call never leaves a stray entry in the switcher. -->
        <activity
            android:name=".plugins.IncomingCallActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SparkleCall"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustNothing" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Modern Android 13+ media read permissions for gallery and camera reel creation -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Legacy Downloads write path for API <= 28 (MediaStore needs no
         permission on 29+) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 13+ runtime notification permission (requested by the
         push/local notifications Capacitor plugins) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Channel vibration (notification channels set vibration=true) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice calls & voice notes (WebView getUserMedia needs the app to hold these) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video calls (@capacitor/camera also declares this; kept explicit for WebView getUserMedia) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Audio routing control: switch between earpiece, speaker and wired/BT headset -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth audio for headsets. Android 12+ requires BLUETOOTH_CONNECT at runtime;
         declare here so it appears in the manifest for the runtime-request flow. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Keep the call service alive when the app goes to the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: declare the specific foreground service types used during calls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Full-screen incoming-call UI on the lock screen.
         Android 14+ requires a runtime permission grant; Google Play policy may also
         restrict apps that are not dedicated call/alarm apps from using this. Add the
         declaration so the runtime-request path works; do not assume delivery universally. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Android Telecom calling integration -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Legacy Bluetooth audio routing (API 22-30). API 31+ uses BLUETOOTH_CONNECT
         alone; without these, a BT headset on Android 11 and below cannot be
         routed by setCommunicationDevice / MODIFY_AUDIO_SETTINGS. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Proximity sensor and screen wake lock for voice calls -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Location access for live location and campus discovery -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Contacts access for contact discovery and friend invites -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
</manifest>
