<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
        android:theme="@style/AppTheme.NoActionBarLaunch"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustNothing"
        android:exported="true">

        <!-- FCM: fallback channel (messages set android.notification.channel_id
             explicitly; this covers any payload without one) + status bar icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="system" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Accent color: circle behind the status-bar icon + accent on Android 5-7 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sparkle_notification_color" />


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: Canonical HTTPS referral invitations -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sparkleapp.com" android:pathPrefix="/invite" />
                <data android:scheme="https" android:host="sparklewebapp.vercel.app" android:pathPrefix="/invite" />
            </intent-filter>

            <!-- Custom Scheme deep link fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sparkle" android:host="invite" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Modern Android 13+ media read permissions for gallery and camera reel creation -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Legacy Downloads write path for API <= 28 (MediaStore needs no
         permission on 29+) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 13+ runtime notification permission (requested by the
         push/local notifications Capacitor plugins) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Channel vibration (notification channels set vibration=true) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice calls & voice notes (WebView getUserMedia needs the app to hold these) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video calls (@capacitor/camera also declares this; kept explicit for WebView getUserMedia) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Audio routing control: switch between earpiece, speaker and wired/BT headset -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth audio for headsets. Android 12+ requires BLUETOOTH_CONNECT at runtime;
         declare here so it appears in the manifest for the runtime-request flow. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Keep the call service alive when the app goes to the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: declare the specific foreground service types used during calls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Full-screen incoming-call UI on the lock screen.
         Android 14+ requires a runtime permission grant; Google Play policy may also
         restrict apps that are not dedicated call/alarm apps from using this. Add the
         declaration so the runtime-request path works; do not assume delivery universally. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
